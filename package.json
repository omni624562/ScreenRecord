{
  "name": "screen-recorder",
  "version": "2.0.0",
  "description": "Windows 11 螢幕錄影 + 加速匯出工具（Rust + Tauri + FFmpeg）",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "cargo run -p screenrecorder-ui",
    "build": "bun run scripts/build.ts",
    "dist": "bun run build && bun run scripts/copy-ffmpeg.ts",
    "typecheck": "tsc --noEmit",
    "test": "cargo test -p screenrecorder-core && bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  }
}
