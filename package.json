{
  "name": "screen-recorder",
  "version": "1.4.0",
  "description": "Windows 11 螢幕錄影 + 加速匯出工具（Bun + FFmpeg）",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts",
    "build": "bun run scripts/build.ts",
    "build:console": "bun run scripts/build.ts --console",
    "dist": "bun run build && bun run scripts/copy-ffmpeg.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  }
}
